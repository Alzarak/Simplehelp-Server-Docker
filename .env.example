# Twingate connector credentials for the SimpleHelp VM.
#
# Copy to .env on the new VM and fill in. Generate the two tokens in the
# Twingate admin console:
#   Remote Network -> Add Connector -> Manual deployment -> Generate Tokens
#
# Create the connector in the SAME Remote Network as the retired prod
# connector (twingate-prodserver-connector). Resources are served by whichever
# connectors sit in their Remote Network, so same-network means coverage is
# automatic; a new Remote Network would mean moving every Resource by hand.
#
# .env is ignored by .gitignore (which denies everything, then allowlists).
# Do not commit real tokens.

TWINGATE_NETWORK=alzanet
TWINGATE_ACCESS_TOKEN=
TWINGATE_REFRESH_TOKEN=
